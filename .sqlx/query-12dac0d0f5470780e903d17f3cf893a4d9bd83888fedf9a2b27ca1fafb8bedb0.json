{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT s.id, subj.name as subject, s.version, s.schema_text as schema,\n                   s.schema_type, s.references\n            FROM schemas s\n            JOIN subjects subj ON s.subject_id = subj.id\n            WHERE subj.name = $1 AND s.schema_text = $2\n            ",
